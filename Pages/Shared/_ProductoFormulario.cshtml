<form id="producto-form" class="producto-form">
    @Html.AntiForgeryToken()
    <div id="producto-form-error" class="producto-form__error" role="alert" tabindex="-1" hidden></div>
    <fieldset id="producto-campos">
        <section class="producto-form__section" aria-labelledby="producto-informacion">
            <header class="producto-form__section-heading"><span class="producto-form__icon" aria-hidden="true">▣</span><div><h3 id="producto-informacion">Información del producto</h3><p>Datos generales y categorización para tu inventario.</p></div><span class="producto-form__section-number">Sección 01</span></header>
            <div class="producto-form__grid">
                <div class="producto-form__field producto-form__wide"><label for="producto-nombre">Nombre del producto <span class="required">*</span></label><input id="producto-nombre" name="nombre" required minlength="3" maxlength="200" placeholder="Ej. Laptop HP ProBook 450 G10 Core i7 16 GB" aria-describedby="producto-nombre-ayuda" autofocus><small id="producto-nombre-ayuda">Usa al menos 3 caracteres que identifiquen el producto.</small></div>
                <div class="producto-form__field"><div class="producto-form__label-row"><label for="producto-sku">Código SKU <span class="required">*</span></label><button id="generar-sku" type="button">↻ Generar SKU</button></div><input id="producto-sku" name="sku" required maxlength="80" placeholder="Ej. TEC-LAP-0024" aria-describedby="producto-sku-ayuda"><small id="producto-sku-ayuda">Identificador único del producto en el catálogo.</small></div>
                <div class="producto-form__field"><label for="producto-categoria">Categoría <span class="required">*</span></label><select id="producto-categoria" name="categoriaId" required disabled><option value="">Cargando categorías…</option></select><small>Selecciona una categoría del catálogo.</small></div>
                <div class="producto-form__field"><label for="producto-marca">Marca o fabricante <span class="required">*</span></label><select id="producto-marca" name="marcaId" required disabled><option value="">Cargando marcas…</option></select><small>Selecciona una marca registrada.</small></div>
                <div class="producto-form__field"><span id="producto-estado-label">Estado comercial <span class="required">*</span></span><div class="producto-form__segmented" role="group" aria-labelledby="producto-estado-label"><label><input type="radio" name="activo" value="true" checked><span>● Activo</span></label><label><input type="radio" name="activo" value="false"><span>● Inactivo</span></label></div><small>Los productos activos estarán disponibles en el catálogo.</small></div>
                <div class="producto-form__field producto-form__wide"><div class="producto-form__label-row"><label for="producto-descripcion">Descripción del producto</label><small id="descripcion-conteo">0 / 250 caracteres</small></div><textarea id="producto-descripcion" name="descripcion" maxlength="250" rows="3" placeholder="Describe las características técnicas, garantía y contenido del paquete." aria-describedby="descripcion-conteo"></textarea></div>
                <div class="producto-form__field producto-form__wide"><label for="producto-imagen">Imagen del producto <span class="producto-form__optional">Opcional</span></label><div class="producto-form__image"><span class="producto-form__image-icon" aria-hidden="true">▧</span><div><input id="producto-imagen" name="imagen" type="url" maxlength="2048" pattern="https://.+" placeholder="https://ejemplo.com/producto.jpg" aria-describedby="producto-imagen-ayuda"><small id="producto-imagen-ayuda">Enlace HTTPS de una imagen accesible. Puedes agregarla después.</small></div></div></div>
            </div>
        </section>
        <section class="producto-form__section producto-form__section--tinted" aria-labelledby="producto-inventario">
            <header class="producto-form__section-heading"><span class="producto-form__icon" aria-hidden="true">＄</span><div><h3 id="producto-inventario">Precio e inventario</h3><p>Precio de venta y umbral de reposición.</p></div><span class="producto-form__section-number">Sección 02</span></header>
            <div class="producto-form__grid producto-form__grid--three">
                <div class="producto-form__field"><label for="producto-precio">Precio de venta <span class="required">*</span></label><div class="producto-form__currency"><span>USD</span><input id="producto-precio" name="precio" type="number" required min="0.01" max="9999999999.99" step="0.01" placeholder="0.00"></div><small>El precio debe ser mayor que cero.</small></div>
                <div class="producto-form__field"><label for="producto-stock">Stock inicial</label><input id="producto-stock" type="number" value="0" readonly aria-describedby="producto-stock-ayuda"><small id="producto-stock-ayuda">Registra las entradas desde ajustes de inventario.</small></div>
                <div class="producto-form__field"><label for="producto-minimo">Stock mínimo de alerta <span class="required">*</span></label><input id="producto-minimo" name="stockMinimo" type="number" required min="0" max="2147483647" step="1" value="2"><small>Alerta cuando el stock sea igual o inferior al mínimo.</small></div>
            </div>
            <div class="producto-form__policy"><span class="producto-form__icon" aria-hidden="true">✓</span><div><strong>Control de inventario</strong><p>El producto se crea sin existencias. Los movimientos de stock se registran por separado.</p></div></div>
        </section>
    </fieldset>
    <p class="producto-form__permission">La creación de productos requiere un perfil administrador.</p>
</form>
