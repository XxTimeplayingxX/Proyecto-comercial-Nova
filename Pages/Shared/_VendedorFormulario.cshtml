<form id="vendedor-form" class="producto-form">
    @Html.AntiForgeryToken()
    <fieldset id="vendedor-campos" class="producto-form__section">
        <div class="producto-form__grid">
            <div class="producto-form__field producto-form__wide" id="vendedor-cuenta">
                <label for="vendedor-usuario">UUID de la cuenta <span class="required">*</span></label>
                <input id="vendedor-usuario" name="usuario" maxlength="36" pattern="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" required autocomplete="off" aria-describedby="vendedor-guia">
                <small id="vendedor-guia">Crea primero la cuenta en Supabase Auth → Users con correo confirmado y contraseña. Copia su UUID aquí.</small>
            </div>
            <div class="producto-form__field">
                <label for="vendedor-nombre">Nombre <span class="required">*</span></label>
                <input id="vendedor-nombre" name="nombre" maxlength="80" autocomplete="off" required>
            </div>
            <div class="producto-form__field">
                <label for="vendedor-apellido">Apellido <span class="required">*</span></label>
                <input id="vendedor-apellido" name="apellido" maxlength="80" autocomplete="off" required>
            </div>
            <div class="producto-form__wide" id="vendedor-estado" hidden>
                <label class="vendedores__check"><input id="vendedor-activo" type="checkbox" checked> Perfil activo</label>
                <p class="vendedores__hint">Un perfil inactivo conserva su historial y pierde acceso a las operaciones comerciales.</p>
            </div>
        </div>
    </fieldset>
    <p class="producto-form__error vendedores__form-error" id="vendedor-error" role="alert" hidden></p>
</form>
