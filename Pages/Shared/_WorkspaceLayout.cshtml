@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@{
    var title = ViewData["Title"] as string;
    var email = User.FindFirstValue(ClaimTypes.Email);
    var toasts = ViewData["Toasts"] as ToastMessage[] ?? [];
    var session = (await Context.AuthenticateAsync()).Properties;
    var sessionNow = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
    var lastActivity = session is null ? null : Nova.Infrastructure.NovaSessionPolicy.LastActivity(session);
}
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@title | Comercial Nova</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true">
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/workspace-controls.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/toast.css" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
    <script src="~/js/toast.js" asp-append-version="true" defer></script>
    <script src="~/js/workspace.js" asp-append-version="true" defer></script>
    <script src="~/js/session.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</head>
<body class="workspace" data-session-user="@User.FindFirstValue(ClaimTypes.NameIdentifier)" data-session-now="@sessionNow" data-session-expires="@session?.ExpiresUtc?.ToUnixTimeSeconds()" data-session-last-activity="@lastActivity" data-idle-warning="@Nova.Infrastructure.NovaSessionPolicy.WarningSeconds" data-idle-timeout="@Nova.Infrastructure.NovaSessionPolicy.IdleSeconds">
    <aside class="workspace__sidebar" id="workspace-sidebar" aria-label="Barra lateral">
        <partial name="_Brand" />
        <partial name="_WorkspaceNav" />
        <partial name="_WorkspaceLogout" />
    </aside>
    <div id="workspace-resize" class="workspace__resize" role="separator" tabindex="0" aria-label="Cambiar ancho de la barra lateral" aria-orientation="vertical" aria-valuemin="200" aria-valuemax="340" aria-valuenow="216" title="Arrastra para ajustar el ancho. Doble clic para restablecer."></div>
    <dialog class="workspace__drawer" id="workspace-menu" aria-label="Navegación principal">
        <div class="workspace__drawer-heading"><partial name="_Brand" /><button class="workspace__menu-close" id="workspace-menu-cerrar" type="button" aria-label="Cerrar menú">×</button></div>
        <partial name="_WorkspaceNav" />
        <partial name="_WorkspaceLogout" />
    </dialog>

    <div class="workspace__main">
        <header class="workspace__header">
            <div class="workspace__header-start"><button id="workspace-sidebar-toggle" class="workspace__sidebar-toggle" type="button" aria-controls="workspace-sidebar" aria-expanded="true" aria-label="Ocultar barra lateral" title="Ocultar barra lateral"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16m7-11-3 3 3 3"/></svg></button><button id="workspace-menu-abrir" class="workspace__menu-toggle" type="button" aria-controls="workspace-menu" aria-expanded="false" aria-label="Abrir menú"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button><p class="workspace__location">@title</p></div>
            @if (!string.IsNullOrWhiteSpace(email))
            {
                <div class="workspace__account-wrap"><button class="workspace__account" id="workspace-account" type="button" aria-expanded="false" aria-controls="workspace-profile">
                    <span title="@email">@email</span>
                    <span class="workspace__avatar" aria-hidden="true">@email[..1].ToUpperInvariant()</span>
                </button><section id="workspace-profile" class="workspace__profile" role="dialog" aria-labelledby="workspace-profile-title" hidden>
                    <h2 id="workspace-profile-title" tabindex="-1">Mi cuenta</h2>
                    <p id="workspace-profile-status" role="status">Consultando información…</p>
                    <dl><dt>Nombre</dt><dd id="workspace-profile-name">—</dd><dt>Apellido</dt><dd id="workspace-profile-lastname">—</dd><dt>Correo</dt><dd>@email</dd><dt>Rol</dt><dd id="workspace-profile-role">—</dd><dt>Sesión restante</dt><dd id="workspace-profile-expiry">—</dd><dt>Duración del token</dt><dd id="workspace-profile-token">—</dd></dl>
                    <button id="workspace-profile-retry" type="button" hidden>Reintentar consulta</button>
                    <button class="workspace__profile-logout" type="submit" form="workspace-session-logout">Cerrar sesión</button>
                </section></div>
            }
        </header>
        <main class="workspace__content">
            @RenderBody()
        </main>
    </div>

    <partial name="_ToastStack" model="toasts" />
    <form id="workspace-session-logout" asp-route="SignOutNova" method="post" asp-antiforgery="true" hidden></form>
    <dialog id="workspace-idle" class="workspace__idle" aria-labelledby="workspace-idle-title" aria-describedby="workspace-idle-description">
        <div class="workspace__idle-icon" aria-hidden="true"><svg viewBox="0 0 80 80" fill="none"><circle class="idle-orbit" cx="40" cy="40" r="34" stroke="currentColor" stroke-opacity=".2" stroke-width="2" stroke-dasharray="4 7"/><circle cx="40" cy="40" r="24" fill="currentColor" fill-opacity=".1"/><g class="idle-face" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M31 34v3m18-3v3"/><path d="M31 45q9 10 18 0"/></g><path class="idle-wave" d="m61 21 5-5m-7 0 1-6m9 13 6-1" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg></div>
        <p class="workspace__idle-eyebrow">Tu sesión está en pausa</p><h2 id="workspace-idle-title">¿Aún sigues allí?</h2>
        <p id="workspace-idle-description">Llevas 2 minutos sin actividad. Confirma que sigues aquí para continuar.</p>
        <p class="workspace__idle-countdown" id="workspace-idle-countdown" role="timer">La sesión se cerrará en 60 segundos.</p>
        <p id="workspace-idle-error" role="status" hidden></p>
        <div><button id="workspace-idle-continue" class="workspace__idle-continue" type="button">Sí, continuar</button><button type="submit" form="workspace-session-logout" class="workspace__idle-leave">Cerrar sesión</button></div>
    </dialog>
</body>
</html>
