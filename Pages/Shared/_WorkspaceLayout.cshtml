@using System.Security.Claims
@{
    var title = ViewData["Title"] as string;
    var email = User.FindFirstValue(ClaimTypes.Email);
    var toasts = ViewData["Toasts"] as ToastMessage[] ?? [];
}
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@title | Comercial Nova</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true">
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/toast.css" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
    <script src="~/js/toast.js" asp-append-version="true" defer></script>
    <script src="~/js/workspace.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</head>
<body class="workspace">
    <aside class="workspace__sidebar">
        <partial name="_Brand" />
        <partial name="_WorkspaceNav" />
        <partial name="_WorkspaceLogout" />
    </aside>
    <dialog class="workspace__drawer" id="workspace-menu" aria-label="Navegación principal">
        <div class="workspace__drawer-heading"><partial name="_Brand" /><button class="workspace__menu-close" id="workspace-menu-cerrar" type="button" aria-label="Cerrar menú">×</button></div>
        <partial name="_WorkspaceNav" />
        <partial name="_WorkspaceLogout" />
    </dialog>

    <div class="workspace__main">
        <header class="workspace__header">
            <div class="workspace__header-start"><button id="workspace-menu-abrir" class="workspace__menu-toggle" type="button" aria-controls="workspace-menu" aria-expanded="false" aria-label="Abrir menú"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button><p class="workspace__location">@title</p></div>
            @if (!string.IsNullOrWhiteSpace(email))
            {
                <div class="workspace__account">
                    <span title="@email">@email</span>
                    <span class="workspace__avatar" aria-hidden="true">@email[..1].ToUpperInvariant()</span>
                </div>
            }
        </header>
        <main class="workspace__content">
            @RenderBody()
        </main>
    </div>

    <partial name="_ToastStack" model="toasts" />
</body>
</html>
